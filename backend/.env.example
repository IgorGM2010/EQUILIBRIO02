# ===== SEGURANCA =====
# Gerar uma string aleatoria longa (minimo 32 caracteres)
# Exemplo: openssl rand -base64 32
# Nunca compartilhar este valor!
JWT_SECRET=sua_chave_secreta_super_longa_aleatorios_qwerty123456789abcdef

# ===== AMBIENTE =====
NODE_ENV=production
PORT=3001

# ===== FRONTEND =====
# URL do frontend onde o HTML esta hospedado
FRONTEND_URL=http://localhost:3000

# ===== FIREBASE REALTIME DATABASE =====
# Firebase sera usado apenas como banco de dados.
# Nao usar Firebase Hosting, Cloud Functions ou deploy do backend no Firebase.
DATABASE_URL=https://equilibrio-d6275-default-rtdb.firebaseio.com
