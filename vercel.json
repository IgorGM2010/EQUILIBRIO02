{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install --prefix backend",
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "index.html",
        "jogar.html",
        "login.html",
        "painel.html",
        "firebase-config.js",
        "backend/src/**",
        "backend/package.json"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
